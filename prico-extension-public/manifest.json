{
  "name": "Prico: Prissjekker",
  "description": "Aldri betal mer for samme produkt igjen",
  "version": "1.13",
  "manifest_version": 3,
  "action": {
    "default_popup": "structure.html",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://api.prico.no/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/icon_logo.png",
        "images/prico.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
